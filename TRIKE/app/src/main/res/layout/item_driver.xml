<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Driver Image -->
    <ImageView
        android:id="@+id/driverImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Delete Button -->
    <ImageButton
        android:id="@+id/deleteBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Driver"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Driver Name -->
    <TextView
        android:id="@+id/driverName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Driver Name"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/driverImage"
        app:layout_constraintTop_toTopOf="@id/driverImage"
        app:layout_constraintEnd_toStartOf="@id/deleteBtn"/>

    <!-- Plate Number -->
    <TextView
        android:id="@+id/plateNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Plate Number"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/driverName"
        app:layout_constraintStart_toStartOf="@id/driverName"
        app:layout_constraintEnd_toEndOf="@id/driverName"/>

    <!-- Terminal -->
    <TextView
        android:id="@+id/terminalText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Terminal: N/A"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/plateNumber"
        app:layout_constraintStart_toStartOf="@id/driverName"
        app:layout_constraintEnd_toEndOf="@id/driverName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
