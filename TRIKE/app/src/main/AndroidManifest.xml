<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.trike">

    <!-- ✅ SMS Permissions for Auto-Send SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- ✅ Fix SMS warning -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.sms" android:required="false" />

    <!-- ✅ Needed for Maps (if used) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TRIKE"
        tools:targetApi="31">

        <!-- ✅ Launcher Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ Remaining Activities -->
        <activity android:name=".VideoPlayerActivity" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SignUpActivity" android:exported="false" />
        <activity android:name=".BooknowActivity" android:exported="false" />
        <activity android:name=".UserHistoryActivity" android:exported="false" />
        <activity android:name=".UserdriverfareActivity" android:exported="false" />
        <activity android:name=".AdminLogin" android:exported="false" />
        <activity android:name=".AdminBookList" android:exported="false" />
        <activity android:name=".AdminlActivity" android:exported="false" />
        <activity android:name=".DriverActivity" android:exported="false" />
        <activity android:name=".AdminMenuActivity" android:exported="false" />
        <activity android:name=".DriverListActivity" android:exported="false" />
        <activity android:name=".AdminFeedbackActivity" android:exported="false" />

    </application>

</manifest>
